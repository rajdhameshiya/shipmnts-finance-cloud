PORT=3002
CLIENT_URL=http://localhost:3003

# Optional but recommended for image invoices and better extraction quality.
# Without this, text-based PDFs are parsed locally with regex/rules.
OPENAI_API_KEY=
# gpt-4o-mini is a cost-conscious default. You can change this to your preferred
# OpenAI vision-capable model.
OPENAI_MODEL=gpt-4o-mini

# Added automatically by Vercel when a private Blob store is connected.
# Set it manually only when running Vercel Functions locally.
BLOB_READ_WRITE_TOKEN=
