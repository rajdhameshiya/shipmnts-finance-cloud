{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/bills/upload.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/inbox/:path*", "destination": "/index.html" },
    { "source": "/exceptions", "destination": "/index.html" },
    { "source": "/drafts", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" }
  ]
}
